{
    "name": "catlabinteractive/laravel-charon-frontend",
    "description": "A laravel frontend to be placed upon a laravel charon rest api to draw fancy interfaces.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thijs Van der Schaeghe",
            "email": "thijs@catlab.be"
        }
    ],
    "require": {
        "php": ">=8.1",
        "catlabinteractive/charon-laravel": "^1.9",
        "catlabinteractive/laravel-table": "^1.0.2",
        "laravel/framework": "^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5.10 || ^10.5 || ^11.0 || ^12.0",
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "CatLab\\CharonFrontend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
